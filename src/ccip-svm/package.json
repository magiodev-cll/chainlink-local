{
  "name": "@chainlink/local-solana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local CCIP simulator for Solana (SVM), powered by Surfpool",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-force-exit \"dist/test/*.test.js\"",
    "test:codec": "npm run build && node --test dist/test/codec.test.js"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.2.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "ethers": "^6.15.0"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
